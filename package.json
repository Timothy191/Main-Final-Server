{
  "name": "arch-systems",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "audit:rls": "node tools/audit-rls.cjs",
    "build": "turbo run build",
    "clean": "turbo run clean && find . -name '.next' -type d -not -path '*/node_modules/*' | xargs rm -rf",
    "clean:all": "pnpm store prune && rm -rf apps/portal/.next/dev apps/portal/.next/cache && pnpm clean && echo '✓ Workspace fully cleaned (pnpm cache + .next dev cache + turbo artifacts)'",
    "deploy:dev": "bash scripts/dev-deploy-login.sh",
    "deploy:live": "bash scripts/live-deployment.sh",
    "deploy:local": "bash scripts/dev.sh",
    "dev": "bash scripts/dev.sh",
    "dev:no-infra": "bash scripts/dev.sh --no-infra",
    "dev:quick": "bash scripts/dev.sh --quick",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "quality": "turbo run lint type-check test --concurrency=4 && pnpm format:check",
    "shutdown": "bash scripts/shutdown.sh",
    "supabase:start": "pnpm dlx supabase@^2.26.0 start --workdir packages",
    "supabase:status": "pnpm dlx supabase@^2.26.0 status --workdir packages",
    "supabase:stop": "pnpm dlx supabase@^2.26.0 stop --workdir packages",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "production-test": "bash scripts/production-test-suite.sh",
    "production-test:url": "bash scripts/production-test-suite.sh --url",
    "production-test:strict": "bash scripts/production-test-suite.sh --strict",
    "production-test:json": "bash scripts/production-test-suite.sh --json",
    "production-test:ci": "bash scripts/production-test-suite.sh --strict --json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.4.2",
    "tsx": "^4.0.0",
    "turbo": "^2.10.2",
    "typescript": "^5.7.0",
    "zod": "^3.24.0"
  }
}
