{
  "name": "arch-systems",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "24.15.0",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "audit:rls": "node tools/audit-rls.cjs",
    "agents:verify": "node tools/agents-verify.mjs",
    "design:ratchet": "node tools/design-ratchet.mjs",
    "theme:shape": "node tools/theme-shape-guard.mjs",
    "lint:tokens": "pnpm --filter @repo/theme lint:tokens",
    "lint:markdown": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"packages/rust-bindings/**\" --ignore \"repowiki/**\" --ignore \"**/target/**\"",
    "guard:imports": "node tools/import-boundary-guard.mjs",
    "guard:ignoresync": "node tools/ignore-sync-guard.mjs",
    "gates": "pnpm lint:markdown && pnpm lint:css && pnpm lint:yaml && pnpm audit:knip && node tools/check-drift-score.mjs && node tools/agents-verify.mjs && node tools/design-ratchet.mjs && node tools/theme-shape-guard.mjs && node tools/next-backend-guard.mjs && node tools/performance-budget-guard.mjs && pnpm --filter @repo/theme lint:tokens && pnpm guard:imports && pnpm guard:ignoresync",
    "analyze": "pnpm --filter portal build:analyze",
    "build": "turbo run build",
    "clean": "turbo run clean && find . -name '.next' -type d -not -path '*/node_modules/*' | xargs rm -rf",
    "clean:all": "pnpm store prune && rm -rf apps/portal/.next/dev apps/portal/.next/cache && pnpm clean && echo '✓ Workspace fully cleaned (pnpm cache + .next dev cache + turbo artifacts)'",
    "deploy:dev": "bash scripts/dev-deploy-login.sh",
    "deploy:live": "bash scripts/live-deployment.sh",
    "deploy:local": "bash scripts/dev.sh",
    "dev": "bash scripts/dev.sh",
    "dev:no-infra": "bash scripts/dev.sh --no-infra",
    "dev:quick": "bash scripts/dev.sh --quick",
    "dev:safe": "bash scripts/dev-supervisor.sh",
    "start:safe": "bash scripts/prod-supervisor.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "quality": "turbo run lint type-check test --concurrency=4 && pnpm format:check && pnpm lint:yaml && pnpm audit:knip && node tools/check-drift-score.mjs && node tools/next-backend-guard.mjs",
    "shutdown": "bash scripts/shutdown.sh",
    "supabase:start": "pnpm dlx supabase@^2.26.0 start --workdir packages",
    "supabase:status": "pnpm dlx supabase@^2.26.0 status --workdir packages",
    "supabase:stop": "pnpm dlx supabase@^2.26.0 stop --workdir packages",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "production-test": "bash scripts/production-test-suite.sh",
    "production-test:url": "bash scripts/production-test-suite.sh --url",
    "production-test:strict": "bash scripts/production-test-suite.sh --strict",
    "production-test:json": "bash scripts/production-test-suite.sh --json",
    "production-test:ci": "bash scripts/production-test-suite.sh --strict --json",
    "audit:knip": "knip",
    "db:codegen": "kysely-codegen --out-file packages/supabase/src/db-types.ts",
    "lint:css": "stylelint --config packages/theme/.stylelintrc.mjs packages/theme/src/css/*.css && stylelint --config packages/ui/.stylelintrc.mjs packages/ui/src/*.css",
    "lint:yaml": "node tools/lint-yaml.mjs",
    "check:drift": "node tools/check-drift-score.mjs",
    "size:check": "size-limit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@size-limit/file": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "better-sqlite3": "^13.0.1",
    "eslint": "catalog:",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "ioredis": "^5.4.1",
    "knip": "^5.45.0",
    "kysely-codegen": "^0.17.0",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "^0.49.1",
    "neon-cli": "^0.10.1",
    "prettier": "catalog:",
    "size-limit": "^11.1.6",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.23.5",
    "turbo": "^2.10.8",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
