{
  "name": "portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:cache-handler && next dev --turbopack --hostname 0.0.0.0",
    "dev:safe": "bash ../../scripts/dev-supervisor.sh",
    "build:cache-handler": "tsc -p tsconfig.cache-handler.json",
    "build": "pnpm build:cache-handler && node scripts/generate-openapi-spec.js && next build",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "start:safe": "bash ../../scripts/prod-supervisor.sh",
    "lint": "node -e \"const cp=require('child_process'); const args=process.argv.slice(1).filter(a=>a!=='--silent'); const res=cp.spawnSync('eslint', args, {stdio:'inherit'}); process.exit(res.status||0);\" -- . --cache --cache-location node_modules/.cache/.eslintcache --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "generate-openapi-spec": "node scripts/generate-openapi-spec.js"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@react-pdf/renderer": "^4.5.1",
    "@repo/acl": "workspace:*",
    "@repo/contract": "workspace:*",
    "@repo/database": "workspace:*",
    "@repo/departments/ui": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/rate-limiter": "workspace:*",
    "@repo/redis": "workspace:*",
    "@repo/supabase": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/ui": "workspace:*",
    "@repo/utils": "workspace:*",
    "@sentry/nextjs": "^9.8.0",
    "@supabase/supabase-js": "^2.49.0",
    "@google/genai": "latest",
    "@vercel/otel": "^1.10.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "@google/genai": "^2.15.0",
    "ioredis": "^5.4.1",
    "inngest": "^4.4.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "16.2.10",
    "next-swagger-doc": "^0.4.1",
    "qr-code-styling": "^1.9.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.48.0",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/parser": "^8.59.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.0.0",
    "server-only": "^0.0.1",
    "swagger-jsdoc": "^6.2.8",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
