{
  "name": "@repo/redis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./stats": {
      "types": "./dist/stats.d.ts",
      "default": "./dist/stats.js"
    },
    "./invalidation": {
      "types": "./dist/invalidation.d.ts",
      "default": "./dist/invalidation.js"
    },
    "./sqlite-client": {
      "types": "./dist/sqlite-client.d.ts",
      "default": "./dist/sqlite-client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit false",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@repo/jest-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "ts-jest": "^29.2.0",
    "typescript": "catalog:"
  }
}
