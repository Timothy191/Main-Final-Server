{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "github.com/cocoindex-io/cocoindex-code": {
      "type": "local",
      "command": [
        "ccc",
        "mcp"
      ],
      "enabled": true
    },
    "codebase-memory": {
      "type": "local",
      "command": [
        "/home/timothy/.local/bin/codebase-memory-mcp"
      ],
      "enabled": true
    },
    "supermemory": {
      "type": "local",
      "command": [
        "/home/timothy/.local/bin/supermemory-mcp"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "remote",
      "url": "http://localhost:6010/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/timothy/Documents/Arch-System"
      ],
      "enabled": true
    },
    "git": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "/home/timothy/Documents/Arch-System"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@localhost:54322/main"
      ],
      "enabled": true
    },
    "sqlite": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "/home/timothy/Documents/Arch-System/benchmark-cache.db"
      ],
      "enabled": true
    },
    "redis": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://localhost:6379"
      ],
      "enabled": true
    },
    "github": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "enabled": true
    },
    "powerbi": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-powerbi"
      ],
      "enabled": true
    },
    "brave-search": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-brave-search"
      ],
      "enabled": true
    },
    "everything-toolkit": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-everything-toolkit"
      ],
      "enabled": true
    },
    "genkit": {
      "type": "stdio",
      "command": [
        "npx",
        "-y",
        "genkit-cli@^1.28.0",
        "mcp"
      ],
      "enabled": true
    }
  }
}
