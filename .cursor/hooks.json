{
  "hooks": {
    "afterFileEdit": [
      {
        "command": "acc hook post-tool --host cursor"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/block-forbidden.mjs",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "acc hook turn-start --host cursor"
      }
    ],
    "sessionStart": [
      {
        "command": "node .cursor/hooks/alignment-gate.mjs",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "acc hook turn-end --host cursor"
      }
    ]
  },
  "version": 1
}