{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": [
    "**/database.types.ts",
    "**/db-types.ts",
    "**/generated.ts",
    "**/_app_legacy_shadow/**",
    "**/src.backup/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["next", "psql", "cargo-cp-artifact"],
  "ignoreDependencies": ["@sentry/nextjs", "inngest", "@vercel/otel"],
  "rules": {
    "files": "off",
    "dependencies": "off",
    "devDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.sh", "scripts/**/*.mjs", "tools/**/*.mjs", "tools/**/*.cjs"]
    },
    "apps/portal": {
      "entry": ["src/app/**/page.tsx", "src/app/**/route.ts", "src/proxy.ts"],
      "ignore": [
        ".claude/skills/run-portal/drive.mjs",
        "e2e/playwright.config.ts",
        "public/sw.js",
        "src/features/ai/components/AiChat.tsx",
        "src/features/departments/index.ts",
        "src/lib/ai/scripts/backfill-embeddings.ts",
        "src/lib/api/api-guard.ts",
        "src/lib/errors/error-handler.ts",
        "src/lib/utils.ts"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts"]
    }
  }
}
